# Separate research runtime. Does not replace the deployed edge-worker image.
FROM sentinel-prototype-edge-worker:latest
RUN pip install --no-cache-dir 'tensorboard==2.20.0' 'seaborn==0.13.2' \
    'ipython==8.37.0' 'GitPython==3.1.45'
RUN pip install --no-cache-dir 'onnx==1.19.1'
ENV WANDB_MODE=disabled COMET_MODE=DISABLED CLEARML_OFFLINE_MODE=1 \
    TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1 MPLBACKEND=Agg
WORKDIR /models/experiments/yolov9-training
