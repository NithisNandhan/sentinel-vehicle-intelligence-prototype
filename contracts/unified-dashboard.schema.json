{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LocalSessionOut": {
      "additionalProperties": false,
      "properties": {
        "csrf_token": {
          "title": "Csrf Token",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "csrf_token",
        "expires_at"
      ],
      "title": "LocalSessionOut",
      "type": "object"
    },
    "WatchlistItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "masked_plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Plate"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "severity",
        "active",
        "version",
        "created_at"
      ],
      "title": "WatchlistItem",
      "type": "object"
    },
    "WatchlistPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/WatchlistItem"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "offset": {
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total",
        "offset",
        "limit",
        "version"
      ],
      "title": "WatchlistPage",
      "type": "object"
    },
    "WatchlistCreate": {
      "additionalProperties": false,
      "properties": {
        "plate": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Plate",
          "type": "string"
        },
        "reason": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "plate",
        "reason"
      ],
      "title": "WatchlistCreate",
      "type": "object"
    },
    "WatchlistPatch": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        }
      },
      "required": [
        "expected_version"
      ],
      "title": "WatchlistPatch",
      "type": "object"
    },
    "WatchlistSearch": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "default": "",
          "maxLength": 240,
          "title": "Query",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "WatchlistSearch",
      "type": "object"
    },
    "CharacterAlternative": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "title": "Character",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "character",
        "score"
      ],
      "title": "CharacterAlternative",
      "type": "object"
    },
    "CharacterEvidence": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "title": "Character",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/CharacterAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "character",
        "score"
      ],
      "title": "CharacterEvidence",
      "type": "object"
    },
    "PlateCandidate": {
      "additionalProperties": false,
      "properties": {
        "plate": {
          "title": "Plate",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "minimum_character_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Character Score"
        },
        "log_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Score"
        },
        "observations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observations"
        }
      },
      "required": [
        "plate",
        "score"
      ],
      "title": "PlateCandidate",
      "type": "object"
    },
    "FrameEvidence": {
      "additionalProperties": false,
      "properties": {
        "pts_ms": {
          "title": "Pts Ms",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterEvidence"
          },
          "title": "Characters",
          "type": "array"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        }
      },
      "required": [
        "pts_ms",
        "width",
        "height"
      ],
      "title": "FrameEvidence",
      "type": "object"
    },
    "ReconstructionEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "contributing_originals": {
          "default": 0,
          "title": "Contributing Originals",
          "type": "integer"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterEvidence"
          },
          "title": "Characters",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/PlateCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReconstructionEvidence",
      "type": "object"
    },
    "TrackDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "vehicle_box": {
          "items": {
            "type": "integer"
          },
          "title": "Vehicle Box",
          "type": "array"
        },
        "vehicle_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "default": "vehicle",
          "title": "Vehicle Class"
        },
        "seen_pts_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seen Pts Ms"
        },
        "observations": {
          "default": 0,
          "title": "Observations",
          "type": "integer"
        },
        "recognition_state": {
          "default": "reading",
          "title": "Recognition State",
          "type": "string"
        },
        "masked_plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Plate"
        },
        "best_reading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Reading"
        },
        "model_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Score"
        },
        "gate_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Gate Reasons",
          "type": "array"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameEvidence"
          },
          "title": "Frames",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/PlateCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reconstruction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReconstructionEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "track_id"
      ],
      "title": "TrackDiagnostics",
      "type": "object"
    },
    "DiagnosticsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_mode": {
          "const": "recorded",
          "default": "recorded",
          "title": "Source Mode",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "camera_id": {
          "title": "Camera Id",
          "type": "string"
        },
        "video_position_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Position Ms"
        },
        "models": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Models",
          "type": "object"
        },
        "stage_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Ms",
          "type": "object"
        },
        "track": {
          "$ref": "#/$defs/TrackDiagnostics"
        }
      },
      "required": [
        "session_id",
        "camera_id",
        "track"
      ],
      "title": "DiagnosticsSnapshot",
      "type": "object"
    }
  }
}
