# Run scripts/init-env.ps1 to generate random local keys in .env.
DB_PASSWORD=GENERATE_DB_PASSWORD
EDGE_API_KEY=GENERATE_EDGE_API_KEY
OPERATOR_API_KEY=GENERATE_OPERATOR_API_KEY
WATCHLIST_HMAC_KEY=GENERATE_HMAC_KEY
DEMO_MODE=true
LOCAL_DASHBOARD_MODE=true
# Local-only UI access; never expose this profile on a LAN/public listener.
LOCAL_DASHBOARD_BIND_HOST=127.0.0.1
LOCAL_DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opt in only for permitted downloaded recordings; live imagery remains blocked.
DASHBOARD_RECORDED_EVIDENCE=false

# Sentinel access stays in .env and is never committed.
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_COOKIE=
SENTINEL_BASE_URL=https://cctv.corp8.cloud
SENTINEL_RTSP_HOST=103.250.160.189
CAMERA_IDS=cam17,cam01

# Experimental reader; default remains unchanged until accuracy review.
# Requires separately cached PARSeq dependencies/source/weights and hybrid assets.
PLATE_READER=temporal-v2
HYBRID_ALIGNMENT=ecc
HYBRID_RESTORATION=false

